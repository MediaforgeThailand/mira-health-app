              <path d="M320 260 L320 54" />
              <path d="M320 260 L520 96" />
              <path d="M320 260 L558 260" />
              <path d="M320 260 L520 424" />
              <path d="M320 260 L320 470" />
              <path d="M320 260 L120 424" />
