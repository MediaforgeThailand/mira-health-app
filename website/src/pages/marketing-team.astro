</html>

<style>
  :global(html) {
    background: #050607;
  }

  :global(body) {
    background: #050607;
  }

  :global(.scroll-progress span) {
    background: linear-gradient(90deg, #4fd8ff, #42e6a4, #f7c56b);
  }

  .marketing-team-page {
    --mt-canvas: #050607;
    --mt-canvas-2: #090d13;
    --mt-surface: #0d1117;
    --mt-surface-2: #121823;
    --mt-line: rgba(229, 241, 255, 0.14);
    --mt-line-strong: rgba(229, 241, 255, 0.24);
    --mt-ink: #f6faff;
    --mt-muted: #aab8c7;
    --mt-soft: #718094;
    --mt-cyan: #4fd8ff;
    --mt-mint: #42e6a4;
    --mt-amber: #f7c56b;
    --mt-violet: #9d7bff;
    --mt-rose: #ff7a9a;
    --mt-container: min(1180px, calc(100vw - 40px));
    position: relative;
    overflow: clip;
    background:
      radial-gradient(ellipse 120% 70% at 50% 0%, rgba(79, 216, 255, 0.16), transparent 55%),
      radial-gradient(ellipse 110% 55% at 20% 30%, rgba(66, 230, 164, 0.08), transparent 55%),
      radial-gradient(ellipse 90% 45% at 82% 18%, rgba(247, 197, 107, 0.08), transparent 52%),
      linear-gradient(180deg, #050607 0%, #080b10 50%, #050607 100%);
    color: var(--mt-ink);
    letter-spacing: 0;
  }

  .marketing-team-page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    content: "";
    background-image:
      linear-gradient(to right, rgba(229, 241, 255, 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(229, 241, 255, 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.48;
    mask-image: linear-gradient(180deg, #000, transparent 82%);
  }

  .marketing-team-page::after {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    content: "";
    background-image:
      radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.12) 0 1px, transparent 1px),
      radial-gradient(circle at 70% 65%, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px);
    background-size: 24px 24px, 19px 19px;
    opacity: 0.08;
  }

  .mt-container {
