  ['Build', 'ทำ asset, ads, web, workflow'],
  ['Launch', 'ปล่อยงานแบบวัดผลได้'],
  ['Measure', 'อ่าน data และ lead quality'],
  ['Optimize', 'ปรับต่อจนระบบดีขึ้น'],
