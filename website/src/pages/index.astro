---
const title = 'Mira AI Sales Platform';
const description =
  'Live Mira AI system shell for AI Sales Chat, Referral Program, and Admin Panel.';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EAF2FF" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <style>
      html,
      body {
        margin: 0;
        min-width: 320px;
        min-height: 100%;
        background: #eaf2ff;
      }

      body {
        overflow: hidden;
      }

      .live-system-frame {
        display: block;
        width: 100vw;
        height: 100vh;
        border: 0;
        background: #eaf2ff;
      }
    </style>
  </head>
  <body>
    <iframe
      class="live-system-frame"
      src="/showcase/"
      title="Mira AI Sales Platform"
    ></iframe>
  </body>
</html>
