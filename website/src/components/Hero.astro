---
import Button from './Button.astro';
import ChatSim from './ChatSim.astro';
import Chip from './Chip.astro';
import MotionLoop from './MotionLoop.astro';
---

<section id="top" class="hero section-dark grain">
  <div class="hero-media" aria-hidden="true">
    <MotionLoop name="hero-aurora" />
  </div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal>MIRA — AI COMMERCE CHAT PLATFORM</p>
      <h1 data-hero-title>
        <span>AI Chat ที่<span class="gradient-text">ขายเป็น</span></span>
        <span>แนะนำ · ตอบ · ปิดการขาย จบใน<span class="nowrap">แชทเดียว</span></span>
      </h1>
      <p class="hero-sub" data-reveal>
        Mira เรียนรู้จากชุดข้อมูลขององค์กรคุณ แล้วเปลี่ยนทุกบทสนทนาให้เป็นยอดขาย — แนะนำสินค้าได้ตรงคน พาลูกค้าไปจนถึงชำระเงิน และส่งต่อให้ทีมของคุณแบบไร้รอยต่อ
      </p>
      <div class="button-row hero-actions" data-reveal>
        <Button href="#contact">นัดดูเดโม</Button>
        <Button href="#ai-chat" variant="ghost">ดูวิธีทำงาน ↓</Button>
      </div>
      <div class="hero-channels" data-reveal>
        <div class="chip-row">
          <Chip tone="dark">PWA</Chip>
          <Chip tone="dark">APP</Chip>
          <Chip tone="dark">LINE OA</Chip>
        </div>
        <p>ปรับให้เข้ากับระบบและแบรนด์ขององค์กรคุณ</p>
      </div>
    </div>
    <div class="hero-device" data-reveal>
      <ChatSim />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(94svh, 920px);
    padding: clamp(6.5rem, 10vw, 8rem) 0 clamp(3rem, 6vw, 5.5rem);
    overflow: clip;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(14, 165, 164, 0.28), transparent 32%),
      radial-gradient(circle at 78% 12%, rgba(84, 207, 165, 0.18), transparent 30%),
      linear-gradient(180deg, var(--night), #082327 82%);
  }

  .hero-media :global(.motion-loop) {
    opacity: 0.8;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(340px, 0.75fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .hero-copy {
    padding-top: 1rem;
  }

  h1 {
    display: grid;
    gap: 0.25rem;
    max-width: 900px;
    margin: 1.2rem 0 0;
    color: var(--canvas);
    font-size: clamp(2.5rem, 6.5vw, 5.25rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.08;
  }

  h1 > span {
    display: block;
  }

  .nowrap {
    white-space: nowrap;
  }

  h1 > span:last-child {
    max-width: 880px;
    font-size: clamp(1.8rem, 4.2vw, 3.75rem);
  }

  .hero-sub {
    max-width: 680px;
    margin: 1.25rem 0 0;
    color: var(--muted-dark);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
  }

  .hero-actions {
    margin-top: 1.75rem;
  }

  .hero-channels {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.4rem;
  }

  .hero-channels p {
    margin: 0;
    color: var(--muted-dark);
    font-size: 0.95rem;
  }

  .hero-device {
    position: relative;
  }

  .hero-device::before {
    position: absolute;
    inset: 12% 4% 4%;
    z-index: -1;
    content: "";
    border-radius: 44%;
    background: radial-gradient(circle, rgba(84, 207, 165, 0.34), transparent 66%);
    filter: blur(30px);
  }

  @media (max-width: 1020px) {
    .hero {
      min-height: auto;
      padding-top: 6.25rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-top: 0;
    }

    .hero-device {
      max-width: 460px;
      margin-inline: auto;
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding-bottom: 3.5rem;
    }

    h1 {
      font-size: clamp(2.1rem, 11vw, 2.85rem);
    }

    h1 > span:last-child {
      font-size: clamp(1.45rem, 7.4vw, 2rem);
    }

    .hero-sub {
      font-size: 0.96rem;
      line-height: 1.58;
    }
  }
</style>
