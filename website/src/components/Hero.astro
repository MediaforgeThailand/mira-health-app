<style>
  .hero {
    position: relative;
    min-height: min(96svh, 960px);
    padding: clamp(6.5rem, 10vw, 8.5rem) 0 0;
    overflow: clip;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 16% 18%, rgba(46, 107, 246, 0.3), transparent 34%),
      radial-gradient(circle at 80% 10%, rgba(127, 177, 254, 0.16), transparent 30%),
      linear-gradient(180deg, var(--night), #082040 84%);
  }

  .hero-media :global(.motion-loop) {
    opacity: 0.85;
  }

  .hero-layer {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(60px);
  }

  .layer-a {
    top: -12%;
    left: -6%;
    width: 46vw;
    height: 46vw;
    background: radial-gradient(circle, rgba(46, 107, 246, 0.3), transparent 64%);
  }

  .layer-b {
    right: -8%;
    bottom: -18%;
    width: 40vw;
    height: 40vw;
    background: radial-gradient(circle, rgba(23, 86, 219, 0.34), transparent 62%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(340px, 0.75fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  h1 {
    display: grid;
    gap: 0.3rem;
    max-width: 900px;
    margin: 1.2rem 0 0;
    color: #F2F6FF;
    font-size: clamp(2.5rem, 6.5vw, 5.25rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .line {
    display: block;
  }

  .line-2 {
    max-width: 880px;
    font-size: clamp(1.7rem, 4vw, 3.4rem);
    color: #C9D8FB;
  }

  :global(html.has-motion) [data-words] .w {
    opacity: 0;
    transform: translateY(44px);
    filter: blur(14px);
  }

  .w {
    display: inline-block;
    will-change: transform, opacity, filter;
  }

  .w.dot {
    color: var(--sky);
  }

  .hero-sub {
    max-width: 680px;
    margin: 1.4rem 0 0;
    color: var(--muted-dark);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
  }

  .hero-actions {
    margin-top: 1.75rem;
  }

  .hero-channels {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .hero-channels p {
    margin: 0;
    color: var(--muted-dark);
    font-size: 0.95rem;
  }

  .hero-device {
    position: relative;
    perspective: 1100px;
  }

  .device-tilt {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .hero-device::before {
    position: absolute;
    inset: 10% 2% 2%;
    z-index: -1;
    content: "";
    border-radius: 44%;
    background: radial-gradient(circle, rgba(63, 142, 252, 0.4), transparent 66%);
    filter: blur(34px);
  }

  .hero-band {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--night-line);
    background: rgba(5, 18, 38, 0.55);
    backdrop-filter: blur(6px);
    padding: 0.85rem 0;
    color: var(--ice);
    font-size: 0.95rem;
  }

  .hero-band :global(.marquee-dot) {
    background: var(--brand-bright);
  }

  @media (max-width: 1020px) {
    .hero {
      min-height: auto;
      padding-top: 6.25rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-device {
      max-width: 460px;
      margin-inline: auto;
    }
  }

  @media (max-width: 520px) {
    h1 {
      font-size: clamp(2.15rem, 11vw, 2.9rem);
    }

    .line-2 {
      font-size: clamp(1.4rem, 7vw, 1.95rem);
    }

    .hero-sub {
      font-size: 0.96rem;
      line-height: 1.6;
    }

    .hero-band {
      font-size: 0.85rem;
    }
  }
</style>
