<style>
  .section-head {
    max-width: 860px;
  }

  .hub {
    display: grid;
    justify-items: center;
    margin-top: 2.5rem;
  }

  .hub-core {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    border: 1px solid rgba(46, 107, 246, 0.35);
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--shadow-glow);
    color: var(--ink);
    font-weight: 600;
    padding: 0.55rem 1rem 0.55rem 0.55rem;
  }

  .hub-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    background: var(--grad-brand);
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
  }

  .hub-beams {
    width: min(100%, 1000px);
    height: 110px;
  }

  .beam {
    fill: none;
    stroke: rgba(46, 107, 246, 0.45);
    stroke-width: 2;
    stroke-dasharray: 6 9;
    animation: beamFlow 1.6s linear infinite;
  }

  .beam.b2 { animation-delay: 0.4s; }
  .beam.b3 { animation-delay: 0.8s; }

  @keyframes beamFlow {
    to {
      stroke-dashoffset: -15;
    }
  }

  .device-grid {
    margin-top: 0.5rem;
  }

  .device-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    padding: 1rem;
    transition: border-color 250ms ease, box-shadow 250ms ease;
  }

  .device-card:hover {
    border-color: rgba(46, 107, 246, 0.35);
    box-shadow: var(--shadow-card);
  }

  .device-frame {
    position: relative;
    display: grid;
    min-height: 250px;
    align-content: end;
    justify-items: start;
    gap: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      radial-gradient(circle at 20% 10%, rgba(46, 107, 246, 0.14), transparent 38%),
      linear-gradient(180deg, var(--canvas), var(--surface));
    padding: 1rem;
    padding-top: 3rem;
    overflow: hidden;
  }

  .device-frame.app {
    border-radius: 26px;
  }

  .device-frame.line {
    background:
      radial-gradient(circle at 82% 12%, rgba(76, 175, 80, 0.16), transparent 34%),
      linear-gradient(180deg, #F4FBF4, var(--surface));
  }

  .browser-chrome {
    position: absolute;
    inset: 0.8rem auto auto 0.9rem;
    display: inline-flex;
    gap: 5px;
  }

  .browser-chrome i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }

  .app-notch {
    position: absolute;
    top: 0.7rem;
    left: 50%;
    width: 38%;
    height: 14px;
    transform: translateX(-50%);
    border-radius: var(--radius-pill);
    background: var(--ink);
    opacity: 0.85;
  }

  .line-badge {
    position: absolute;
    inset: 0.8rem auto auto 0.9rem;
    border-radius: 8px;
    background: #19C158;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
  }

  .mini-bubble {
    max-width: 92%;
    border-radius: 13px 13px 13px 5px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8rem;
    line-height: 1.45;
    padding: 0.5rem 0.7rem;
  }

  .mini-bubble.user {
    justify-self: end;
    border: 0;
    border-radius: 13px 13px 5px 13px;
    background: var(--grad-brand);
    color: #fff;
  }

  .device-frame.line .mini-bubble.user {
    background: linear-gradient(108deg, #18A94D, #2ECC71);
  }

  .mini-action {
    justify-self: stretch;
    border-radius: var(--radius-pill);
    background: var(--brand);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.55rem 0.9rem;
    text-align: center;
  }

  .device-frame.line .mini-action {
    background: #18A94D;
  }

  h3 {
    margin: 1rem 0 0;
    font-family: "Space Grotesk", "Anuphan", sans-serif;
    font-size: 1.4rem;
    line-height: 1.2;
  }

  p {
    margin: 0.45rem 0 0;
    color: var(--ink-soft);
  }

  .footnote-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
    margin-top: 1.6rem;
  }

  .footnote-row span {
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink-soft);
    padding: 0.55rem 0.85rem;
  }

  .footnote-row .mini-cta {
    margin: 0 0 0 auto;
  }

  @media (max-width: 880px) {
    .hub-beams {
      display: none;
    }

    .hub {
      margin-bottom: 1.5rem;
    }

    .footnote-row .mini-cta {
      margin-left: 0;
    }
  }
</style>
