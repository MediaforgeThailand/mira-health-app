---
import Section from './Section.astro';

const devices = [
  { title: 'PWA', body: 'เปิดจากเบราว์เซอร์ ไม่ต้องติดตั้ง', frame: 'browser' },
  { title: 'App', body: 'iOS / Android ในแบรนด์ของคุณ', frame: 'app' },
  { title: 'LINE OA', body: 'คุยใน LINE ที่ลูกค้าคุ้นเคย', frame: 'line' },
];
---

<Section id="channels" tone="light" class="channels-section">
  <div class="section-heading" data-reveal>
    <h2 class="section-title">ลูกค้าอยู่ตรงไหน ก็คุยกับ Mira ได้</h2>
    <p class="section-sub">เราปรับ Mira ให้เข้ากับระบบและแบรนด์ขององค์กรคุณ — ไม่ใช่ให้คุณปรับเข้าหาเรา</p>
  </div>

  <div class="device-grid grid-3">
    {devices.map((device) => (
      <article class="device-card" data-reveal>
        <div class:list={['device-frame', device.frame]}>
          <span class="device-bar" aria-hidden="true"></span>
          <span class="device-bubble accent" aria-hidden="true"></span>
          <span class="device-bubble" aria-hidden="true"></span>
          <span class="device-action" aria-hidden="true"></span>
        </div>
        <h3>{device.title}</h3>
        <p>{device.body}</p>
      </article>
    ))}
  </div>

  <div class="footnote-row" data-reveal>
    <span>เชื่อมต่อกับระบบเดิมขององค์กร</span>
    <span>CI / White-label เต็มรูปแบบ</span>
  </div>
</Section>

<style>
  .section-heading {
    max-width: 820px;
  }

  .device-grid {
    margin-top: 2.25rem;
  }

  .device-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    padding: 1rem;
  }

  .device-frame {
    position: relative;
    display: grid;
    min-height: 260px;
    align-content: end;
    gap: 0.65rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      radial-gradient(circle at 20% 10%, rgba(84, 207, 165, 0.22), transparent 34%),
      linear-gradient(180deg, var(--canvas), var(--surface));
    padding: 1rem;
    overflow: hidden;
  }

  .device-frame.app {
    border-radius: 28px;
  }

  .device-frame.line {
    background:
      radial-gradient(circle at 82% 16%, rgba(84, 207, 165, 0.3), transparent 30%),
      linear-gradient(180deg, #F7FFFC, var(--surface));
  }

  .device-bar,
  .device-bubble,
  .device-action {
    display: block;
    border-radius: var(--radius-pill);
  }

  .device-bar {
    position: absolute;
    inset: 1rem auto auto 1rem;
    width: 48%;
    height: 12px;
    background: var(--blue-soft);
  }

  .device-bubble {
    width: 74%;
    height: 42px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .device-bubble.accent {
    width: 88%;
    margin-left: auto;
    background: var(--teal-soft);
  }

  .device-action {
    width: 54%;
    height: 38px;
    background: var(--teal);
  }

  h3 {
    margin: 1rem 0 0;
    font-family: "Space Grotesk", "Anuphan", sans-serif;
    font-size: 1.4rem;
    line-height: 1.2;
  }

  p {
    margin: 0.45rem 0 0;
    color: var(--ink-soft);
  }

  .footnote-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.4rem;
  }

  .footnote-row span {
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink-soft);
    padding: 0.55rem 0.85rem;
  }
</style>
