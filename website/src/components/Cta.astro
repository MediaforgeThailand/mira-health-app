<style>
  .cta-section {
    position: relative;
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    overflow: clip;
  }

  .cta-media {
    position: absolute;
    inset: 0;
    opacity: 0.3;
  }

  .cta-spot {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(560px circle at var(--mx, 70%) var(--my, 30%), rgba(46, 107, 246, 0.22), transparent 60%);
  }

  .cta-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 0.7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .section-title {
    max-width: 780px;
  }

  .cta-ticks {
    display: grid;
    gap: 0.7rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cta-ticks li {
    position: relative;
    color: var(--muted-dark);
    padding-left: 1.9rem;
  }

  .cta-ticks li::before {
    position: absolute;
    top: 0.18rem;
    left: 0;
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: rgba(84, 207, 165, 0.16);
    color: var(--mint);
    content: "âœ“";
    font-size: 0.7rem;
    font-weight: 700;
  }

  .contact-form {
    display: grid;
    gap: 0.9rem;
    border-radius: 28px;
    box-shadow: var(--shadow-glow);
    padding: clamp(1.1rem, 2.6vw, 1.6rem);
  }

  label {
    display: grid;
    gap: 0.38rem;
    color: var(--muted-dark);
    font-size: 0.92rem;
  }

  input,
  select {
    width: 100%;
    min-height: 48px;
    border: 1px solid var(--night-line);
    border-radius: 14px;
    background: rgba(214, 226, 255, 0.08);
    color: #EAF1FF;
    padding: 0.75rem 0.85rem;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  input:focus,
  select:focus {
    border-color: rgba(63, 142, 252, 0.65);
    box-shadow: 0 0 0 3px rgba(46, 107, 246, 0.22);
    outline: none;
  }

  select option {
    background: var(--night);
    color: #EAF1FF;
  }

  button {
    position: relative;
    min-height: 52px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--grad-brand);
    box-shadow: var(--shadow-glow);
    color: #fff;
    cursor: pointer;
    font-weight: 600;
    overflow: hidden;
    transition: transform 180ms ease;
  }

  button::before {
    position: absolute;
    inset: 0;
    content: "";
    transform: translateX(-110%) skewX(-16deg);
    background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, 0.34) 50%, transparent 80%);
    transition: transform 700ms var(--ease-out);
  }

  button:hover::before {
    transform: translateX(110%) skewX(-16deg);
  }

  button:hover {
    transform: translateY(-2px);
  }

  .form-foot {
    margin: 0;
    color: var(--muted-dark);
    font-size: 0.85rem;
    text-align: center;
  }

  .form-note {
    margin: 0;
    border-radius: 12px;
    background: rgba(84, 207, 165, 0.13);
    color: var(--mint);
    font-size: 0.88rem;
    padding: 0.6rem 0.8rem;
    text-align: center;
  }

  @media (max-width: 860px) {
    .cta-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
