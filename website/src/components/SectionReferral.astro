    pointer-events: none;
  }

  .story-card.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .story-panel:not(:has(.story-card.is-active)) .story-card:last-child {
    opacity: 1;
    transform: none;
  }

  .story-profile {
