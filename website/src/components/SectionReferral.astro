  }

  .stage-head .section-title {
    font-size: clamp(2rem, 4.6vw, 3.8rem);
  }

  .stage-body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.75fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: stretch;
    margin-top: clamp(1.75rem, 3vw, 2.75rem);
  }

  .steps-rail {
    position: relative;
    display: grid;
  }

  .progress-rail {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0;
    width: 3px;
    border-radius: var(--radius-pill);
    background: rgba(214, 226, 255, 0.12);
  }

  .progress-rail span {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleY(0);
    transform-origin: top;
    border-radius: inherit;
    background: var(--grad-brand);
    box-shadow: 0 0 18px var(--glow-brand);
  }

  .referral-steps {
    display: grid;
    gap: clamp(0.8rem, 1.6vw, 1.3rem);
    padding-left: clamp(1.4rem, 2.5vw, 2rem);
  }

  .referral-step {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 1rem;
    align-items: start;
    opacity: 0.38;
    transition: opacity 240ms ease, transform 240ms ease;
  }

  .referral-step.is-done {
    opacity: 0.62;
  }

  .referral-step.is-active {
    opacity: 1;
    transform: translateX(10px);
  }

  .step-glyph {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border: 1px solid var(--night-line);
    border-radius: 18px;
    background: rgba(214, 226, 255, 0.06);
    color: var(--sky);
    transition: background 240ms ease, box-shadow 240ms ease, color 240ms ease;
  }

  .step-glyph svg {
    width: 22px;
    height: 22px;
  }

  .referral-step.is-active .step-glyph {
    background: var(--grad-brand);
    box-shadow: 0 0 26px var(--glow-brand);
    color: #fff;
  }

  .referral-step.is-done .step-glyph {
    color: var(--mint);
  }

  .step-number {
    display: block;
    color: var(--sky);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }

  h3 {
    margin: 0.2rem 0 0;
    color: #F2F6FF;
    font-size: clamp(1.18rem, 2.3vw, 1.55rem);
    line-height: 1.25;
  }

  .referral-step p {
    margin: 0.45rem 0 0;
    color: var(--muted-dark);
  }

  .commission-counter {
    display: inline-flex;
    margin-top: 0.65rem;
    border-radius: var(--radius-pill);
    background: rgba(84, 207, 165, 0.14);
    box-shadow: 0 0 24px rgba(84, 207, 165, 0.25);
    color: var(--mint);
    font-size: 1.35rem;
    padding: 0.2rem 0.8rem;
  }

  /* story panel */
  .story-panel {
    position: relative;
    min-height: 420px;
    border-radius: 26px;
    overflow: hidden;
  }

  .story-card {
    position: absolute;
